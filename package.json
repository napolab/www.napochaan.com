{
  "name": "www.napochaan.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r run lint",
    "fmt": "pnpm -r run fmt",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:cms": "pnpm --filter cms dev",
    "payload": "pnpm --filter cms payload",
    "payload:migrate": "pnpm --filter cms payload:migrate",
    "payload:migrate:create": "pnpm --filter cms payload:migrate:create",
    "payload:generate-importmap": "pnpm --filter cms payload:generate-importmap",
    "seed:export": "pnpm --filter cms seed:export",
    "seed:import": "pnpm --filter cms seed:import",
    "seed:import:prod": "pnpm --filter cms seed:import:prod",
    "deploy:database:check:staging": "pnpm --filter cms deploy:database:check:staging",
    "deploy:database:staging": "pnpm --filter cms deploy:database:staging",
    "deploy:database:check:production": "pnpm --filter cms deploy:database:check:production",
    "deploy:database:production": "pnpm --filter cms deploy:database:production",
    "deploy:staging": "pnpm --filter cms deploy:staging && pnpm --filter web deploy:staging",
    "deploy:production": "pnpm --filter cms deploy:production && pnpm --filter web deploy:production"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "undici": ">=7.24.0",
      "fast-xml-parser": ">=4.5.5",
      "lodash": ">=4.18.0",
      "drizzle-orm": ">=0.45.2",
      "dompurify": ">=3.3.2"
    }
  }
}
