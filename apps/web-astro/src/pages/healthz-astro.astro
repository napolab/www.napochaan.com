---
// Temporary end-to-end probe (scaffold spike): one CMS read through the request
// context's wrapped binding. Deleted once real pages land.
import { getCMSClient } from '@lib/cms/client';

const res = await getCMSClient().profile.$get();
const profile = res.ok ? await res.json() : undefined;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title>healthz-astro</title>
  </head>
  <body>
    <h1>healthz-astro</h1>
    <p data-testid="cms-status">{res.status}</p>
    <p data-testid="cms-name">{profile?.name ?? 'unavailable'}</p>
  </body>
</html>
