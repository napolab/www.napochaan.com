---
// Port of apps/web/src/app/(site)/news/(index)/page/[num]/page.tsx: pages 2+. Status is
// decided before any HTML: a non-canonical number or a page past the end is a 404
// (Next streamed the past-the-end `notFound()` inside Suspense, so it answered 200), and
// `/news/page/1` collapses onto `/news` (Next `permanentRedirect` → 308).
import NewsList from '../../../features/news/news-list.astro';
import { loadNewsList } from '../../../features/news/load-news-list';
import { newsPageMetadata } from '../../../features/news/metadata';
import { parsePageParam } from '../../../features/shared/lib/parse-page-param';
import * as s from '../../../features/shared/styles.css';
import SiteLayout from '../../../layouts/site-layout.astro';

const num = Astro.params.num ?? '';
const pageNumber = parsePageParam(num);
if (pageNumber === undefined) return Astro.rewrite('/404');
if (pageNumber === 1) return Astro.redirect('/news', 308);

const page = await loadNewsList(pageNumber);
if (page === undefined) return Astro.rewrite('/404');
---

<SiteLayout metadata={newsPageMetadata(num)}>
  <main id="main-content" class={s.main}>
    <NewsList page={page} />
  </main>
</SiteLayout>
