# Workers Static Assets header rules (copied into the build's client output by Astro).
# Cloudflare's edge refuses to compress responses carrying a strong ETag, so
# hashed-immutable assets drop the ETag entirely and rely on `immutable`
# caching instead — no revalidation, no validator needed. Pair: the HTML
# (worker-rendered) side is handled by worker/middleware/weaken-etag.ts.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  ! ETag

# Next's file-convention OG / icon URLs (hashed names already on social cards and in
# crawler caches). Next served them as routes with the cms page policy; keep it.
/opengraph-image-12o0cb.png
  Cache-Control: public, max-age=0, s-maxage=31536000
/twitter-image-12o0cb.png
