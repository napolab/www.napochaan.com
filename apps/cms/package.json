{
  "name": "cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build --webpack",
    "preview": "CLOUDFLARE_ENV=staging opennextjs-cloudflare build --env staging && opennextjs-cloudflare preview --env staging",
    "deploy:staging": "CLOUDFLARE_ENV=staging opennextjs-cloudflare build --env staging && CLOUDFLARE_ENV=staging opennextjs-cloudflare deploy --env staging",
    "deploy:production": "CLOUDFLARE_ENV=production opennextjs-cloudflare build --env production && CLOUDFLARE_ENV=production opennextjs-cloudflare deploy --env production",
    "deploy:database:staging": "CLOUDFLARE_ENV=staging payload migrate",
    "deploy:database:check:staging": "CLOUDFLARE_ENV=staging payload migrate:check-drift",
    "deploy:database:production": "CLOUDFLARE_ENV=production payload migrate",
    "deploy:database:check:production": "CLOUDFLARE_ENV=production payload migrate:check-drift",
    "payload": "payload",
    "payload:migrate": "payload migrate",
    "payload:migrate:create": "payload migrate:create",
    "payload:generate-importmap": "payload generate:importmap",
    "payload:seed": "payload seed",
    "seed:export": "payload seed:export",
    "seed:import": "payload seed:import",
    "seed:import:prod": "payload seed:import:prod",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "fmt": "pnpm run fmt:oxfmt && pnpm run fmt:oxlint",
    "fmt:oxfmt": "oxfmt --write .",
    "fmt:oxlint": "oxlint --fix --ignore-pattern migrations --ignore-pattern src/app/\\(payload\\)/admin/importMap.js .",
    "lint": "pnpm run lint:oxfmt && pnpm run lint:oxlint",
    "lint:oxfmt": "oxfmt --check .",
    "lint:oxlint": "oxlint --ignore-pattern migrations --ignore-pattern src/app/\\(payload\\)/admin/importMap.js .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@napochaan/cms-api": "workspace:*",
    "@napolab/cloudflare-access-core": "0.0.0",
    "@napolab/payload-cloudflare-access": "0.0.0",
    "@opennextjs/cloudflare": "1.20.12",
    "@payloadcms/db-d1-sqlite": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-seo": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-r2": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "bson-objectid": "^2.0.4",
    "dayjs": "^1.11.21",
    "hono": "^4.12.23",
    "jose": "^6.2.3",
    "neverthrow": "^8.2.0",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "shiki": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.5",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20251229.1",
    "oxfmt": "^0.21.0",
    "oxlint": "^1.36.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.151.3"
  }
}
