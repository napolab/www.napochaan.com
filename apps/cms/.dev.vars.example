# `wrangler types`（pnpm cf:types）はこのファイルのキーも CloudflareEnv 型に流し込む。
# 値はプレースホルダ。ローカル開発では .dev.vars にコピーして実値を入れること。
PAYLOAD_SECRET=dev-placeholder
PREVIEW_SECRET=dev-placeholder

# Cloudflare Access（Payload admin ログイン）。stg/prod は wrangler vars で設定。空なら plugin 無効で password ログイン。
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# MCP（/mcp）の AUD。cms はホスト全体 app 1 つなので stg/prod では CF_ACCESS_AUD と同値（wrangler vars で設定）。
# カンマ区切り可。空なら /mcp は 500（fail closed）。
CF_ACCESS_MCP_AUD=
