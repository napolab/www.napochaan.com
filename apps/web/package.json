{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "prepare": "panda codegen && astro sync",
    "panda": "panda",
    "fmt": "pnpm run fmt:oxfmt && pnpm run fmt:oxlint",
    "fmt:oxfmt": "oxfmt --write .",
    "fmt:oxlint": "oxlint --fix --ignore-pattern .claude/worktrees .",
    "lint": "pnpm run lint:oxfmt && pnpm run lint:oxlint",
    "lint:oxfmt": "oxfmt --check .",
    "lint:oxlint": "oxlint --ignore-pattern .claude/worktrees .",
    "typecheck": "astro sync && tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy:staging": "CLOUDFLARE_ENV=staging astro build && wrangler deploy --env staging",
    "deploy:production": "CLOUDFLARE_ENV=production astro build && wrangler deploy --env production && BASE_URL=https://napochaan.com node scripts/warm-cache.mjs",
    "warm:cache": "node scripts/warm-cache.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "~14.4.7",
    "@astrojs/react": "~7.1.8",
    "@fontsource/m-plus-1": "^5.3.1",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@hono/zod-validator": "^0.9.0",
    "@internationalized/date": "^3.12.2",
    "@marsidev/react-turnstile": "^1.5.3",
    "@napochaan/cms-api": "workspace:*",
    "@payloadcms/live-preview-react": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@resvg/resvg-wasm": "2.6.2",
    "astro": "~7.4.11",
    "budoux": "^0.8.4",
    "dayjs": "^1.11.21",
    "durabcast": "^0.2.4",
    "fast-json-stable-stringify": "^2.1.0",
    "gsap": "^3.15.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hono": "^4.12.23",
    "neverthrow": "^8.2.0",
    "react": "19.2.9",
    "react-aria-components": "^1.18.0",
    "react-dom": "19.2.9",
    "reconnecting-websocket": "^4.4.0",
    "satori": "0.29.0",
    "shiki": "^4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.5",
    "@pandacss/dev": "^1.11.1",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20251229.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^4.1.8",
    "oxfmt": "^0.21.0",
    "oxlint": "^1.36.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.3",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18",
    "vitest-browser-react": "^2.2.0",
    "wrangler": "^4.161.0"
  }
}
