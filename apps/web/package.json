{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "prepare": "panda codegen",
    "panda": "panda",
    "fmt": "pnpm run fmt:oxfmt && pnpm run fmt:oxlint",
    "fmt:oxfmt": "oxfmt --write .",
    "fmt:oxlint": "oxlint --fix --ignore-pattern .claude/worktrees .",
    "lint": "pnpm run lint:oxfmt && pnpm run lint:oxlint",
    "lint:oxfmt": "oxfmt --check .",
    "lint:oxlint": "oxlint --ignore-pattern .claude/worktrees .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run",
    "preview": "CLOUDFLARE_ENV=staging opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging opennextjs-cloudflare build --env staging && CLOUDFLARE_ENV=staging opennextjs-cloudflare deploy --env staging",
    "deploy:production": "CLOUDFLARE_ENV=production opennextjs-cloudflare build --env production && CLOUDFLARE_ENV=production opennextjs-cloudflare deploy --env production && BASE_URL=https://napochaan.com node scripts/warm-cache.mjs",
    "warm:cache": "node scripts/warm-cache.mjs",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@internationalized/date": "^3.12.2",
    "@marsidev/react-turnstile": "^1.5.3",
    "@napochaan/cms-api": "workspace:*",
    "@opennextjs/cloudflare": "1.20.12",
    "@payloadcms/live-preview-react": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@radix-ui/react-slot": "^1.2.4",
    "budoux": "^0.8.4",
    "dayjs": "^1.11.21",
    "durabcast": "^0.2.4",
    "fast-json-stable-stringify": "^2.1.0",
    "gsap": "^3.15.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hono": "^4.12.23",
    "neverthrow": "^8.2.0",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.2.9",
    "react-aria-components": "^1.17.0",
    "react-dom": "19.2.9",
    "reconnecting-websocket": "^4.4.0",
    "server-only": "^0.0.1",
    "shiki": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.5",
    "@pandacss/dev": "^1.11.1",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20251229.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.2",
    "oxfmt": "^0.21.0",
    "oxlint": "^1.36.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.3",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18",
    "vitest-browser-react": "^2.1.0",
    "wrangler": "^4.151.3"
  }
}
