---
// `.astro` twin of the ContactList Server Component (markup mirrors ./index.tsx); each
// label's ScrambleText is the only island.
import { ScrambleTextIsland } from '@components/scramble-text/island';

import * as styles from './styles.css';

type Props = {
  items: readonly { label: string; handle: string; href: string }[];
};

const { items } = Astro.props;
const pathname = Astro.url.pathname;
---

<ul class={styles.root}>
  {
    items.map((item) => (
      <li>
        <a class={styles.link} href={item.href} target="_blank" rel="noopener noreferrer">
          <ScrambleTextIsland client:load pathname={pathname} props={{ children: item.label, className: styles.label }} />
          <span class={styles.handle}>{item.handle}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </li>
    ))
  }
</ul>
