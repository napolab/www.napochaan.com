---
// `.astro` twin of the ContactList Server Component (markup mirrors ./index.tsx); each
// label's ScrambleText is a `<scramble-text>` element (no React island).
import ScrambleText from '@components/scramble-text/scramble-text.astro';

import * as styles from './styles.css';

type Props = {
  items: readonly { label: string; handle: string; href: string }[];
};

const { items } = Astro.props;
---

<ul class={styles.root}>
  {
    items.map((item) => (
      <li>
        <a class={styles.link} href={item.href} target="_blank" rel="noopener noreferrer">
          <ScrambleText text={item.label} className={styles.label} />
          <span class={styles.handle}>{item.handle}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </li>
    ))
  }
</ul>
