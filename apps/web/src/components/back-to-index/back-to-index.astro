---
// `.astro` twin of the BackToIndex Server Component (markup mirrors ./index.tsx); the
// label's ScrambleText is a `<scramble-text>` element (no React island).
import { Link } from '@components/link';
import ScrambleText from '@components/scramble-text/scramble-text.astro';

import * as styles from './styles.css';

type Props = {
  href: string;
  label: string;
};

const { href, label } = Astro.props;
---

<Link href={href} className={styles.root} tone="accent" underline={false}>
  <span class={styles.arrow} aria-hidden="true">←</span><span class={styles.label}><ScrambleText text={label} /></span>
</Link>
