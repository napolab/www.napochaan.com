---
// `.astro` twin of the SafeAreaTint Server Component (markup mirrors ./index.tsx);
// ScrollRangeSync is the only island. Rendered once, by the site layout's shell
// backdrop: the root persists across ClientRouter navigations (ScrollRangeSync
// re-observes the swapped <body> on `astro:after-swap`).
import { ScrollRangeSyncIsland } from './island';
import * as styles from './styles.css';

const pathname = Astro.url.pathname;
---

<div class={styles.root} aria-hidden="true" data-testid="safe-area-tint" transition:persist="safe-area-tint">
  <div class={styles.strip} data-testid="safe-area-tint-strip"></div>
  <div class={styles.bottomClip}><div class={styles.stripBottom} data-testid="safe-area-tint-strip-bottom"></div></div>
  <ScrollRangeSyncIsland client:load pathname={pathname} props={{}} />
</div>
