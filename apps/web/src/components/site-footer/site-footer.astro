---
// `.astro` twin of the SiteFooter Server Component (markup mirrors ./index.tsx): the
// section nav (FooterNav) and the two ScrambleText labels are the only islands. Below
// the fold, so they hydrate on visibility.
import { Link } from '@components/link';
import { ScrambleTextIsland } from '@components/scramble-text/island';

import { FooterNavIsland } from './island';
import * as styles from './styles.css';

type Props = {
  buildId?: string;
};

const { buildId } = Astro.props;
const pathname = Astro.url.pathname;
---

<footer class={styles.root}>
  <FooterNavIsland client:visible pathname={pathname} props={{}} />
  <div class={styles.meta}>
    <span>© 2026 napochaan — graphic / digital</span>
    <span class={styles.status}>build {buildId ?? 'dev'} · <span class={styles.live}>life: running</span> · <Link href="/colophon" tone="muted"><ScrambleTextIsland client:visible pathname={pathname} props={{ children: 'colophon' }} /></Link> · <a class={styles.sitemap} href="/sitemap.xml"><ScrambleTextIsland client:visible pathname={pathname} props={{ children: 'sitemap' }} /></a></span>
  </div>
</footer>
