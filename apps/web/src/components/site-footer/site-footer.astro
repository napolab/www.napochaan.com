---
// `.astro` twin of the SiteFooter Server Component (markup mirrors ./index.tsx). No
// islands: the section nav is the static footer-nav.astro twin and every label is a
// `<scramble-text>` element (no React).
import { Link } from '@components/link';
import ScrambleText from '@components/scramble-text/scramble-text.astro';

import FooterNav from './footer-nav.astro';
import * as styles from './styles.css';

type Props = {
  buildId?: string;
};

const { buildId } = Astro.props;
const pathname = Astro.url.pathname;
---

<footer class={styles.root}>
  <FooterNav />
  <div class={styles.meta}>
    <span>© 2026 napochaan — graphic / digital</span>
    <span class={styles.status}>build {buildId ?? 'dev'} · <span class={styles.live}>life: running</span> · <Link href="/colophon" tone="muted"><ScrambleText text="colophon" /></Link> · <a class={styles.sitemap} href="/sitemap.xml"><ScrambleText text="sitemap" /></a></span>
  </div>
</footer>
