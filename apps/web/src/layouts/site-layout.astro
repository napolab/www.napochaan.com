---
// Port of apps/web/src/app/(site)/layout.tsx. The page `<main>` (the slot) is
// swapped on every ClientRouter navigation; the stateful shell pieces are siblings
// with `transition:persist` (set on their root elements, inside loading-overlay.astro,
// shell-backdrop.astro, sys-bar.astro and cursor-presence.astro) so their DOM and
// running state (life simulation, cursor WebSocket, boot overlay, SysBar clock)
// survive. The shell hydrates no React: every interactive piece is a custom element
// (.claude/rules/astro-islands.md). Never put persist on an element that wraps
// <slot /> — `main` would then never swap.
import { ClientRouter } from 'astro:transitions';

import { buildMetadata, THEME_COLOR, VIEWPORT } from '@components/seo/build-metadata';
import Seo from '@components/seo/seo.astro';
import LoadingOverlay from '@components/loading-overlay/loading-overlay.astro';
import CursorPresence from '@components/cursor-presence/cursor-presence.astro';
import ShellBackdrop from '@components/site-shell/shell-backdrop.astro';
import SiteFooter from '@components/site-footer/site-footer.astro';
import { stage } from '@components/site-shell/styles.css';
import { formatClock } from '@components/sys-bar/format-clock';
import SysBar from '@components/sys-bar/sys-bar.astro';
import { imageBlurScriptHtml } from '@components/image/blur-script';
import { fontVariables } from '@themes/fonts';
import { root as themeRoot } from '@themes/provider/styles.css';
import { typekitLoaderHtml } from '@themes/typekit';
import { clsx } from '@utils/clsx';
import { motionBootScriptHtml } from '@utils/motion-cookie';
import { getRequestOrigin } from '@utils/request-url';
import { rootStateCarryScriptHTML } from '@utils/root-state-carry';

import type { MetadataInput } from '@components/seo/build-metadata';

import '@themes/global.css';

type Props = {
  metadata: MetadataInput;
  bodyClass?: string;
};

const { metadata, bodyClass } = Astro.props;
const resolved = buildMetadata(metadata, await getRequestOrigin());
// Stamped on the server so SysBar's clock renders in SSR; under Workers Cache it is
// the cache-generation time and snaps to the live clock once the <sys-bar> element
// connects.
const initialTime = formatClock();
// `wf-loading boot` is in the SSR <html> class (not added by JS) so the boot overlay
// covers the page from the very first paint; the Typekit loader only REMOVES boot. On
// soft navigations the root-state carry script keeps the live class
// (see @utils/root-state-carry). The four head scripts are `is:inline` without
// `data-astro-rerun`, so each runs once per full document load.
// `transition:animate="none"` on <html>: soft navigations swap instantly, as the
// Next site did — no root cross-fade for anyone, regardless of the OS reduced-motion
// setting or the SysBar motion toggle.
---

<html lang="ja" class={`${fontVariables} wf-loading boot`} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={VIEWPORT} />
    <meta name="theme-color" content={THEME_COLOR} />
    <Seo metadata={resolved} />
    <script is:inline set:html={typekitLoaderHtml.__html} />
    <script is:inline set:html={motionBootScriptHtml.__html} />
    <script is:inline set:html={imageBlurScriptHtml.__html} />
    <script is:inline set:html={rootStateCarryScriptHTML.__html} />
    <ClientRouter />
  </head>
  <body class={clsx(themeRoot, bodyClass)}>
    <LoadingOverlay />
    <ShellBackdrop />
    <div data-cursor-surface class={stage}>
      <SysBar initialTime={initialTime} />
      <slot />
      <SiteFooter />
    </div>
    <CursorPresence />
  </body>
</html>
