---
// Port of (site)/not-found.tsx + [...not-found]/page.tsx. Astro renders this route
// for every unmatched path with status 404 (the worker passes it through).
import { NotFoundIsland } from '@components/error-screen/screens';
import SiteLayout from '../layouts/site-layout.astro';
---

<SiteLayout metadata={{ noindex: true }}>
  <NotFoundIsland client:load pathname={Astro.url.pathname} props={{}} />
</SiteLayout>
