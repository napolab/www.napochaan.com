---
// Port of apps/web/src/app/(site)/about/{layout,page}.tsx. The worker stamps the
// purge-driven `cms` policy; a CMS publish purges it. A missing profile is a 404
// (Next `notFound()`), decided before any HTML is written.
import AboutContent from '../features/about/about-content.astro';
import { resolveAboutMetadata } from '../features/about/metadata';
import SiteLayout from '../layouts/site-layout.astro';
import { findProfile } from '@lib/cms/profile';
import { buildLinkHeader } from '@utils/seo/link-header';

const profile = await findProfile();
if (profile === undefined) return Astro.rewrite('/404');

const metadata = resolveAboutMetadata(profile);
// RFC 8288 discovery links; set here, not in the layout (see @utils/seo/link-header).
Astro.response.headers.set('Link', buildLinkHeader(metadata));
---

<SiteLayout metadata={metadata}>
  <AboutContent profile={profile} />
</SiteLayout>
