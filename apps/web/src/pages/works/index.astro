---
// Port of apps/web/src/app/(site)/works/{layout,(index)/layout,(index)/page}.tsx: page 1
// of the archive. Deeper pages live at path-keyed `/works/page/[num]` (never `?page=N` —
// .claude/rules/workers-cache.md). The worker stamps the purge-driven `cms` policy.
import WorksList from '../../features/works/works-list.astro';
import { loadWorksList } from '../../features/works/load-works-list';
import { worksIndexMetadata } from '../../features/works/metadata';
import * as s from '../../features/shared/styles.css';
import SiteLayout from '../../layouts/site-layout.astro';
import { buildLinkHeader } from '@utils/seo/link-header';

const page = await loadWorksList(1);
if (page === undefined) return Astro.rewrite('/404');

// RFC 8288 discovery links; set here, not in the layout (see @utils/seo/link-header).
Astro.response.headers.set('Link', buildLinkHeader(worksIndexMetadata));
---

<SiteLayout metadata={worksIndexMetadata}>
  <main id="main-content" class={s.main}>
    <WorksList page={page} />
  </main>
</SiteLayout>
