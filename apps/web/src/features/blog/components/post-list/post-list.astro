---
// Port of the PostList Server Component. Each PostCard is an `.astro` twin (a static
// card link whose title scrambles on hover without React). Cards get only the fields
// they render (never the body) and a server-formatted date (see ./post-card).
import { formatPostDate } from '../../lib/format-post-date';
import PostCard from './post-card.astro';
import * as styles from './styles.css';

import type { Post } from '../../post';

type Props = {
  posts: readonly Post[];
};

const { posts } = Astro.props;
---

<ol class={styles.list}>
  {
    posts.map((post) => (
      <li>
        <PostCard post={post} formattedDate={formatPostDate(post.date)} />
      </li>
    ))
  }
</ol>
