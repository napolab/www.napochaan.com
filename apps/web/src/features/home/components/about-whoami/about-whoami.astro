---
// Port of the (site) AboutWhoami Server Component. Server-only markup; the heading's
// "$ whoami" more-link label (ScrambleText) is the only client leaf, passed through
// SectionHeading's `more` slot.
import { ScrambleTextIsland } from '@components/scramble-text/island';
import { SectionHeading } from '@components/section-heading';

import * as styles from './styles.css';

type Props = {
  id?: string;
  skills: readonly string[];
  now: string;
  likes: string;
  wants: string;
};

const { id, skills, now, likes, wants } = Astro.props;
const pathname = Astro.url.pathname;
const rows = [
  { key: 'skills', value: skills.join(' · ') },
  { key: 'now', value: now },
  { key: 'likes', value: likes },
  { key: 'wants', value: wants },
];
---

<section id={id} class={styles.root}>
  <SectionHeading no="00" moreHref="/about">about<ScrambleTextIsland slot="more" client:load pathname={pathname} props={{ children: '$ whoami' }} /></SectionHeading>
  <div class={styles.who}>
    <p class={styles.prompt}>$ whoami</p>
    {
      rows.map((row) => (
        <p class={styles.row}>
          <span class={styles.key}>{row.key}</span>
          <span class={styles.value}>{row.value}</span>
        </p>
      ))
    }
  </div>
</section>
