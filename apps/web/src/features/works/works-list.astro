---
// Port of the works `(index)` layout + WorksListSection: the list chrome (PageHeader +
// feed link, list routes only) and one page of the archive. The page decides the 404
// before rendering this (see ./lib/paginate-works). WorksArchive is an `.astro` twin
// (static rows whose titles scramble without React); it gets only the fields it renders
// (never the body). Pagination and FeedLink render without a directive.
import { FeedLink } from '@components/feed-link';
import PageHeader from '@components/page-header/page-header.astro';
import { Pagination } from '@components/pagination';

import WorksArchive from './components/works-archive/works-archive.astro';
import { worksPageHref } from './lib/paginate-works';
import { toWorkCard } from './work-card';

import type { WorksPage } from './lib/paginate-works';

type Props = {
  page: WorksPage;
};

const { page } = Astro.props;
const crumbs = [{ href: '/', label: 'home' }, { label: 'works' }];
---

<PageHeader title="works" breadcrumbs={crumbs} kicker="// archive — dev·vrchat·video·graphic" lead="なにかを作るって楽しいんだよなぁ〜😁" />
<FeedLink href="/works/rss.xml" label="works の RSS フィード" />
<WorksArchive works={page.works.map(toWorkCard)} />
{page.totalPages > 1 && <Pagination currentPage={page.current} totalPages={page.totalPages} href={worksPageHref} />}
